{
  "name": "philhealth-calamity-claims-monitor",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env backend/server.js",
    "test": "npm run check:emoji && node --test --test-reporter=tap backend/test/*.test.js && cd .. && node --test --test-reporter=tap scripts/check-no-emoji.test.mjs",
    "seed": "node --env-file-if-exists=.env backend/seed.js",
    "check:emoji": "node ../scripts/check-no-emoji.mjs",
    "db:inspect": "node --env-file=.env backend/inspect-aiven-schema.js",
    "db:validate-migration": "node --env-file=.env backend/validate-aiven-migration.js",
    "db:migrate": "node --env-file=.env backend/migrate-postgres.js",
    "seed:postgres-demo": "node --env-file=.env backend/seed-postgres-demo.js",
    "test:postgres": "node --env-file=.env --test backend/test/postgres.test.js",
    "db:backup": "node --env-file=.env backend/backup-postgres.js",
    "db:verify-backup": "node --env-file=.env backend/verify-postgres-backup.js"
  },
  "dependencies": {
    "argon2": "^0.41.1",
    "better-sqlite3": "^12.4.1",
    "csv-parse": "^7.0.3",
    "exceljs": "^4.4.0",
    "fastify": "^5.12.8",
    "lucide-static": "^1.61.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.16.3",
    "zod": "^4.6.7"
  },
  "allowScripts": {
    "argon2@0.41.1": true,
    "better-sqlite3@12.11.1": true
  },
  "overrides": {
    "uuid": "^11.1.1",
    "minimatch": "^11.0.4",
    "exceljs": {
      "unzipper": "^0.12.5"
    },
    "glob": "^14.0.3"
  }
}
